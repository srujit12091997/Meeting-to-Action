# Copy this file to ".env" and fill in the real values.
# The real .env must NEVER be committed to git (add it to .gitignore).

# --- LLM provider: "gemini" (free tier, default) or "anthropic" ---
LLM_PROVIDER=gemini

# --- Google Gemini (free tier — DEFAULT) ---
# Get a free key (no card) from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest

# --- Claude / Anthropic (optional; only if LLM_PROVIDER=anthropic) ---
# Get from https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Notion ---
# 1) Integration token from https://www.notion.so/my-integrations (starts with "ntn_" or "secret_")
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
# 2) The ID of the Tasks database you create and share with the integration (see NOTION_SETUP.md)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
