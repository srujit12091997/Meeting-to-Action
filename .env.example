# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# --- LLM provider: "gemini" (free tier) or "anthropic" ---
LLM_PROVIDER=gemini

# --- Google Gemini (free tier; get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-lite-latest

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# --- Notion (see srujit/NOTION_SETUP.md) ---
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Slack (for follow-up nudges; optional until Cycle 1 follow-up step) ---
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_DEFAULT_CHANNEL=#meeting-tasks

# --- Email (SMTP) for "Send summary email" (optional) ---
# Gmail: enable 2FA -> create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# --- Database ---
# MVP: local SQLite. Production: swap to a Supabase/Postgres URL.
DATABASE_URL=sqlite:///./meeting_agent.db

# --- Whisper (STT) ---
WHISPER_MODEL=base.en        # base.en/tiny.en fast on CPU; small/medium need GPU
WHISPER_DEVICE=cpu           # cpu | cuda (cuda needs cuBLAS+cuDNN installed)
WHISPER_COMPUTE_TYPE=int8    # int8 (fast, low VRAM) | float16

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
API_BASE_URL=http://localhost:8000
